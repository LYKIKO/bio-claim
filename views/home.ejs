<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Claim Your Profile</title>
    <link rel="preconnect" href="https://rsms.me/">
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --black: #000000;
            --white: #FFFFFF;
            --blue: #2563EB;
            --blue-hover: #1D4ED8;
            --blue-light: #EFF6FF;
            --gray-50: #F9FAFB;
            --gray-100: #F3F4F6;
            --gray-200: #E5E7EB;
            --gray-300: #D1D5DB;
            --gray-400: #9CA3AF;
            --gray-500: #6B7280;
            --gray-600: #4B5563;
            --gray-700: #374151;
            --gray-800: #1F2937;
            --gray-900: #111827;
            --radius: 5px;
            --shadow: 0 4px 20px rgba(0,0,0,0.08);
            --shadow-lg: 0 10px 40px rgba(0,0,0,0.12);
            --transition: 200ms ease;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
            background: var(--white);
            color: var(--black);
            min-height: 100vh;
            line-height: 1.5;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        /* ============ NAVBAR ============ */
        .navbar {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background: rgba(255,255,255,0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--gray-200);
            height: 64px;
            display: flex;
            align-items: center;
        }

        .navbar-inner {
            max-width: 1200px;
            width: 100%;
            margin: 0 auto;
            padding: 0 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            color: var(--black);
            font-weight: 600;
            font-size: 18px;
            letter-spacing: -0.02em;
        }

        .nav-brand-icon {
            width: 32px;
            height: 32px;
            background: var(--black);
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .nav-brand-icon svg {
            width: 16px;
            height: 16px;
            stroke: var(--white);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-link {
            text-decoration: none;
            color: var(--gray-600);
            font-size: 14px;
            font-weight: 500;
            padding: 8px 14px;
            border-radius: var(--radius);
            transition: var(--transition);
        }

        .nav-link:hover {
            color: var(--black);
            background: var(--gray-100);
        }

        .nav-link.active {
            color: var(--blue);
            background: var(--blue-light);
        }

        .nav-cta {
            background: var(--blue);
            color: var(--white);
            font-size: 14px;
            font-weight: 500;
            padding: 8px 18px;
            border-radius: var(--radius);
            text-decoration: none;
            transition: var(--transition);
            margin-left: 8px;
        }

        .nav-cta:hover {
            background: var(--blue-hover);
        }

        .nav-mobile-toggle {
            display: none;
            background: none;
            border: none;
            cursor: pointer;
            padding: 8px;
        }

        .nav-mobile-toggle svg {
            width: 24px;
            height: 24px;
            stroke: var(--black);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        /* ============ HERO / WELCOME ============ */
        .hero {
            padding: 144px 24px 80px;
            background: var(--white);
            border-bottom: 1px solid var(--gray-200);
        }

        .hero-inner {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 64px;
            align-items: center;
        }

        .hero-content {
            max-width: 520px;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--gray-100);
            color: var(--gray-700);
            padding: 6px 14px;
            border-radius: 100px;
            font-size: 13px;
            font-weight: 500;
            margin-bottom: 24px;
            border: 1px solid var(--gray-200);
        }

        .hero-tag-dot {
            width: 6px;
            height: 6px;
            background: var(--blue);
            border-radius: 50%;
            animation: pulse 2s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.4; }
        }

        .hero h1 {
            font-size: 48px;
            font-weight: 700;
            line-height: 1.1;
            letter-spacing: -0.03em;
            color: var(--black);
            margin-bottom: 20px;
        }

        .hero h1 span {
            color: var(--blue);
        }

        .hero-desc {
            font-size: 18px;
            color: var(--gray-500);
            line-height: 1.7;
            margin-bottom: 32px;
        }

        .hero-cta-group {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        .btn {
            padding: 14px 28px;
            border: none;
            border-radius: var(--radius);
            font-size: 15px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn-primary {
            background: var(--blue);
            color: var(--white);
        }

        .btn-primary:hover:not(:disabled) {
            background: var(--blue-hover);
        }

        .btn-primary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-outline {
            background: transparent;
            color: var(--black);
            border: 1px solid var(--gray-200);
        }

        .btn-outline:hover {
            background: var(--gray-50);
            border-color: var(--gray-300);
        }

        .btn-secondary {
            background: var(--black);
            color: var(--white);
        }

        .btn-secondary:hover:not(:disabled) {
            background: var(--gray-800);
        }

        .btn-secondary:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .btn-ghost {
            background: transparent;
            color: var(--gray-500);
            padding: 8px;
            font-size: 14px;
            width: auto;
        }

        .btn-ghost:hover:not(:disabled) {
            color: var(--black);
        }

        .btn-link {
            background: transparent;
            color: var(--blue);
            padding: 8px;
            font-size: 14px;
            width: auto;
            text-decoration: none;
        }

        .btn-link:hover:not(:disabled) {
            color: var(--blue-hover);
        }

        .btn-link:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .hero-visual {
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .hero-card-preview {
            width: 100%;
            max-width: 400px;
            background: var(--white);
            border: 1px solid var(--gray-200);
            border-radius: var(--radius);
            padding: 32px;
            box-shadow: var(--shadow-lg);
            position: relative;
        }

        .hero-card-preview::before {
            content: '';
            position: absolute;
            top: -8px;
            right: -8px;
            width: 100%;
            height: 100%;
            border: 1px solid var(--gray-200);
            border-radius: var(--radius);
            z-index: -1;
        }

        .preview-avatar {
            width: 64px;
            height: 64px;
            background: var(--gray-100);
            border-radius: 50%;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .preview-avatar svg {
            width: 28px;
            height: 28px;
            stroke: var(--gray-400);
            fill: none;
            stroke-width: 1.5;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .preview-name {
            font-size: 20px;
            font-weight: 600;
            margin-bottom: 4px;
        }

        .preview-handle {
            font-size: 14px;
            color: var(--gray-400);
            margin-bottom: 20px;
        }

        .preview-links {
            display: flex;
            gap: 8px;
            flex-wrap: wrap;
        }

        .preview-link {
            padding: 6px 14px;
            background: var(--gray-100);
            border-radius: 100px;
            font-size: 12px;
            font-weight: 500;
            color: var(--gray-600);
        }

        /* ============ FEATURES SECTION ============ */
        .features-section {
            padding: 80px 24px;
            background: var(--gray-50);
            border-bottom: 1px solid var(--gray-200);
        }

        .features-inner {
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            text-align: center;
            margin-bottom: 48px;
        }

        .section-header h2 {
            font-size: 32px;
            font-weight: 700;
            letter-spacing: -0.02em;
            margin-bottom: 12px;
        }

        .section-header p {
            font-size: 16px;
            color: var(--gray-500);
            max-width: 500px;
            margin: 0 auto;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
        }

        .feature-card {
            background: var(--white);
            border: 1px solid var(--gray-200);
            border-radius: var(--radius);
            padding: 32px;
            transition: var(--transition);
        }

        .feature-card:hover {
            box-shadow: var(--shadow);
            border-color: var(--gray-300);
        }

        .feature-icon {
            width: 44px;
            height: 44px;
            background: var(--gray-100);
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 16px;
        }

        .feature-icon svg {
            width: 20px;
            height: 20px;
            stroke: var(--black);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .feature-card h3 {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 8px;
        }

        .feature-card p {
            font-size: 14px;
            color: var(--gray-500);
            line-height: 1.6;
        }

        /* ============ CLAIM SECTION ============ */
        .claim-section {
            padding: 80px 24px;
            background: var(--white);
        }

        .claim-inner {
            max-width: 520px;
            margin: 0 auto;
        }

        .claim-card {
            background: var(--white);
            border: 1px solid var(--gray-200);
            border-radius: var(--radius);
            padding: 48px;
            box-shadow: var(--shadow);
            text-align: center;
        }

        .claim-logo {
            width: 48px;
            height: 48px;
            background: var(--black);
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 24px;
        }

        .claim-logo svg {
            width: 24px;
            height: 24px;
            stroke: var(--white);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .claim-card h2 {
            font-size: 24px;
            font-weight: 600;
            color: var(--black);
            margin-bottom: 4px;
            letter-spacing: -0.02em;
        }

        .claim-subtitle {
            font-size: 15px;
            color: var(--gray-500);
            margin-bottom: 32px;
            font-weight: 400;
        }

        /* Discord Auth Button */
        .btn-discord {
            background: #5865F2;
            color: var(--white);
            padding: 14px 32px;
            border-radius: var(--radius);
            border: none;
            font-size: 16px;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 12px;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
            box-shadow: 0 4px 12px rgba(88, 101, 242, 0.3);
            width: 100%;
            justify-content: center;
        }

        .btn-discord:hover {
            background: #4752C4;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(88, 101, 242, 0.4);
        }

        .btn-discord svg {
            width: 24px;
            height: 24px;
            fill: currentColor;
            flex-shrink: 0;
        }

        .btn-discord:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }

        .claim-divider {
            display: flex;
            align-items: center;
            gap: 16px;
            margin: 32px 0 24px;
            color: var(--gray-400);
            font-size: 13px;
        }

        .claim-divider::before,
        .claim-divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--gray-200);
        }

        .claim-features {
            display: flex;
            justify-content: center;
            gap: 32px;
            margin-top: 32px;
            padding-top: 32px;
            border-top: 1px solid var(--gray-200);
        }

        .claim-feature-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
        }

        .claim-feature-item .icon {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--gray-100);
            border-radius: var(--radius);
            font-size: 16px;
        }

        .claim-feature-item .label {
            font-size: 12px;
            color: var(--gray-400);
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        /* Logged in state */
        .logged-in-card {
            background: var(--gray-50);
            border-radius: var(--radius);
            padding: 24px;
            margin-top: 24px;
            border: 1px solid var(--gray-200);
        }

        .logged-in-avatar {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            margin: 0 auto 12px;
            background: #5865F2;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            font-weight: 700;
            color: white;
            overflow: hidden;
        }

        .logged-in-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .logged-in-name {
            font-size: 18px;
            font-weight: 600;
        }

        .logged-in-username {
            font-size: 14px;
            color: var(--gray-500);
        }

        .btn-dashboard {
            display: inline-block;
            background: var(--black);
            color: var(--white);
            padding: 10px 24px;
            border-radius: var(--radius);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            transition: var(--transition);
            margin-top: 12px;
        }

        .btn-dashboard:hover {
            background: var(--gray-800);
        }

        .btn-logout {
            display: inline-block;
            background: transparent;
            color: var(--gray-500);
            padding: 10px 24px;
            border-radius: var(--radius);
            text-decoration: none;
            font-size: 14px;
            border: 1px solid var(--gray-200);
            transition: var(--transition);
            margin-top: 12px;
            margin-left: 8px;
        }

        .btn-logout:hover {
            color: #DC2626;
            border-color: #DC2626;
        }

        /* ============ FOOTER ============ */
        .footer {
            background: var(--black);
            color: var(--white);
            padding: 64px 24px 32px;
        }

        .footer-inner {
            max-width: 1200px;
            margin: 0 auto;
        }

        .footer-top {
            display: grid;
            grid-template-columns: 2fr 1fr 1fr 1fr;
            gap: 48px;
            margin-bottom: 48px;
        }

        .footer-brand {
            max-width: 300px;
        }

        .footer-brand .nav-brand {
            color: var(--white);
            margin-bottom: 16px;
        }

        .footer-brand .nav-brand-icon {
            background: var(--white);
        }

        .footer-brand .nav-brand-icon svg {
            stroke: var(--black);
        }

        .footer-brand p {
            font-size: 14px;
            color: var(--gray-400);
            line-height: 1.7;
        }

        .footer-column h4 {
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--gray-400);
            margin-bottom: 16px;
        }

        .footer-column ul {
            list-style: none;
        }

        .footer-column li {
            margin-bottom: 10px;
        }

        .footer-column a {
            color: var(--gray-300);
            text-decoration: none;
            font-size: 14px;
            transition: var(--transition);
        }

        .footer-column a:hover {
            color: var(--white);
        }

        .footer-bottom {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 32px;
            border-top: 1px solid var(--gray-800);
        }

        .footer-bottom p {
            font-size: 13px;
            color: var(--gray-500);
        }

        .footer-social {
            display: flex;
            gap: 12px;
        }

        .footer-social a {
            width: 36px;
            height: 36px;
            border: 1px solid var(--gray-800);
            border-radius: var(--radius);
            display: flex;
            align-items: center;
            justify-content: center;
            transition: var(--transition);
        }

        .footer-social a:hover {
            border-color: var(--gray-600);
            background: var(--gray-800);
        }

        .footer-social a svg {
            width: 16px;
            height: 16px;
            stroke: var(--gray-400);
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

        .footer-social a:hover svg {
            stroke: var(--white);
        }

        /* ============ LOADING SPINNER ============ */
        .loading-spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255,255,255,0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 0.8s ease-in-out infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        /* ============ TOAST NOTIFICATION ============ */
        .toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .toast {
            padding: 16px 24px;
            background: var(--black);
            color: var(--white);
            border-radius: var(--radius);
            box-shadow: var(--shadow-lg);
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 300px;
            animation: slideIn 0.3s ease;
            transform-origin: bottom right;
        }

        .toast-success {
            background: #059669;
        }

        .toast-error {
            background: #DC2626;
        }

        .toast-info {
            background: var(--blue);
        }

        .toast svg {
            width: 20px;
            height: 20px;
            stroke: currentColor;
            fill: none;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            flex-shrink: 0;
        }

        .toast-message {
            font-size: 14px;
            font-weight: 500;
            flex: 1;
        }

        .toast-close {
            background: none;
            border: none;
            color: rgba(255,255,255,0.7);
            cursor: pointer;
            padding: 4px;
            font-size: 18px;
            transition: var(--transition);
        }

        .toast-close:hover {
            color: var(--white);
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateX(100px); }
            to { opacity: 1; transform: translateX(0); }
        }

        @keyframes slideOut {
            from { opacity: 1; transform: translateX(0); }
            to { opacity: 0; transform: translateX(100px); }
        }

        .toast-hide {
            animation: slideOut 0.3s ease forwards;
        }

        /* ============ RESPONSIVE ============ */
        @media (max-width: 1024px) {
            .hero-inner {
                grid-template-columns: 1fr;
                text-align: center;
            }

            .hero-content {
                max-width: 100%;
            }

            .hero-cta-group {
                justify-content: center;
            }

            .hero-visual {
                display: none;
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-top {
                grid-template-columns: 1fr 1fr;
            }
        }

        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .nav-mobile-toggle {
                display: block;
            }

            .hero {
                padding: 112px 16px 64px;
            }

            .hero h1 {
                font-size: 36px;
            }

            .hero-desc {
                font-size: 16px;
            }

            .features-section {
                padding: 64px 16px;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .claim-section {
                padding: 64px 16px;
            }

            .claim-card {
                padding: 32px 24px;
            }

            .footer {
                padding: 48px 16px 24px;
            }

            .footer-top {
                grid-template-columns: 1fr;
                gap: 32px;
            }

            .footer-bottom {
                flex-direction: column;
                gap: 16px;
                text-align: center;
            }

            .claim-features {
                gap: 24px;
            }

            .toast {
                min-width: auto;
                max-width: calc(100vw - 48px);
            }

            .toast-container {
                bottom: 16px;
                right: 16px;
                left: 16px;
            }
        }
    </style>
</head>

<body>
    <!-- ============ NAVBAR ============ -->
    <nav class="navbar">
        <div class="navbar-inner">
            <a href="/" class="nav-brand">
                <div class="nav-brand-icon">
                    <svg viewBox="0 0 24 24">
                        <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                    </svg>
                </div>
                ProfileLink
            </a>
            <div class="nav-links">
                <a href="#features" class="nav-link">Features</a>
                <a href="#claim" class="nav-link">Claim Profile</a>
                <a href="#" class="nav-link">Pricing</a>
                <% if (user) { %>
                    <a href="/dashboard" class="nav-link" style="color: var(--blue);">Dashboard</a>
