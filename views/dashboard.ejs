                                                    <input type="text" id="cardColorText" value="<%= profile.theme && profile.theme.cardColor ? profile.theme.cardColor : '#1a1a1a' %>" placeholder="#RRGGBB">
                                                </div>
                                            </div>

                                            <div style="margin-top: 12px;">
                                                <label style="display: block; font-size: 12px; font-weight: 500; color: var(--gray); margin-bottom: 8px;">Quick Presets</label>
                                                <div style="display: flex; gap: 10px; flex-wrap: wrap;">
