        </main>
    </div>

    <div class="toast-container" id="toastContainer"></div>

    <script>
        // ===== COLLAPSIBLE CATEGORIES =====
        function toggleCategory(categoryId) {
            const section = document.getElementById(categoryId);
            if (!section) return;
            section.classList.toggle('open');
        }

        // ===== TAB SWITCHING =====
        function switchTab(tabId) {
            document.querySelectorAll('.nav-item[data-tab]').forEach(item => {
                item.classList.remove('active');
            });

            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });

            const selectedTab = document.getElementById(tabId + 'Tab');
            if (selectedTab) {
                selectedTab.classList.add('active');
            }

            const navItem = document.querySelector(`.nav-item[data-tab="${tabId}"]`);
            if (navItem) {
                navItem.classList.add('active');
            }

            const titles = {
                'profile': 'Profile <span>Manage your profile</span>',
                'theme': 'Theme <span>Customize your profile</span>',
                'settings': 'Settings <span>Account preferences</span>'
            };
            document.getElementById('pageTitle').innerHTML = titles[tabId] || 'Dashboard';
        }

        document.querySelectorAll('.nav-item[data-tab]').forEach(item => {
            item.addEventListener('click', function(e) {
                e.preventDefault();
                const tabId = this.dataset.tab;
                switchTab(tabId);
                if (window.innerWidth <= 768) {
                    toggleSidebar();
                }
            });
        });

        // ===== THEME PREVIEW =====
        const previewCard = document.getElementById('previewProfileCard');
        const previewAvatar = document.getElementById('previewAvatar');
        const previewName = document.getElementById('previewName');
        const previewUsername = document.getElementById('previewUsername');
        const previewGlassBadge = document.getElementById('previewGlassBadge');
        const previewBioSection = document.getElementById('previewBioSection');
        const previewBioText = document.getElementById('previewBioText');
        const previewSubTabs = document.getElementById('previewSubTabs');
        const previewDetailsGrid = document.getElementById('previewDetailsGrid');
        const previewSocialLinks = document.getElementById('previewSocialLinks');
        const previewDetailsPanel = document.getElementById('previewDetailsPanel');
        const previewSocialPanel = document.getElementById('previewSocialPanel');

        const cardColor = document.getElementById('cardColor');
        const cardColorText = document.getElementById('cardColorText');
        const cardTransparency = document.getElementById('cardTransparency');
        const cardBlur = document.getElementById('cardBlur');
        const glassToggle = document.getElementById('glassToggle');
        const glassControls = document.getElementById('glassControls');
        const glassStatus = document.getElementById('glassStatus');
        const borderRadius = document.getElementById('borderRadius');

        // Sub Tab elements
        const subTabRadius = document.getElementById('subTabRadius');
        const subTabRadiusValue = document.getElementById('subTabRadiusValue');
        const subTabBg = document.getElementById('subTabBg');
        const subTabBgText = document.getElementById('subTabBgText');
        const subTabText = document.getElementById('subTabText');
        const subTabTextValue = document.getElementById('subTabTextValue');
        const subTabLabel = document.getElementById('subTabLabel');
        const subTabLabelValue = document.getElementById('subTabLabelValue');

        // Hover color elements
        const detailHoverBg = document.getElementById('detailHoverBg');
        const detailHoverBgText = document.getElementById('detailHoverBgText');
        const socialHoverBg = document.getElementById('socialHoverBg');
        const socialHoverBgText = document.getElementById('socialHoverBgText');
        const twitterHover = document.getElementById('twitterHover');
        const twitterHoverText = document.getElementById('twitterHoverText');
        const githubHover = document.getElementById('githubHover');
        const githubHoverText = document.getElementById('githubHoverText');
        const instagramHover = document.getElementById('instagramHover');
        const instagramHoverText = document.getElementById('instagramHoverText');
        const youtubeHover = document.getElementById('youtubeHover');
        const youtubeHoverText = document.getElementById('youtubeHoverText');
        const linkedinHover = document.getElementById('linkedinHover');
        const linkedinHoverText = document.getElementById('linkedinHoverText');

        // Preview sub tab switching
        document.querySelectorAll('.preview-sub-tab').forEach(btn => {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.preview-sub-tab').forEach(b => b.classList.remove('active'));
                this.classList.add('active');
                const tab = this.dataset.tab;
                if (tab === 'details') {
                    previewDetailsPanel.style.display = 'block';
                    previewSocialPanel.style.display = 'none';
                } else {
                    previewDetailsPanel.style.display = 'none';
                    previewSocialPanel.style.display = 'block';
                }
            });
        });

        function isLightColor(hex) {
            if (!hex) return false;
            if (hex.startsWith('rgba')) {
                const matches = hex.match(/[\d.]+/g);
                if (matches) {
                    const r = parseFloat(matches[0]);
                    const g = parseFloat(matches[1]);
                    const b = parseFloat(matches[2]);
                    const brightness = (r * 299 + g * 587 + b * 114) / 1000;
                    return brightness > 155;
                }
                return false;
            }
            const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
            if (!result) return false;
            const r = parseInt(result[1], 16);
            const g = parseInt(result[2], 16);
            const b = parseInt(result[3], 16);
            const brightness = (r * 299 + g * 587 + b * 114) / 1000;
            return brightness > 155;
        }

        function updatePreview() {
            const color = cardColor.value;
            const transparency = cardTransparency ? parseInt(cardTransparency.value) / 100 : 1;
            const blur = cardBlur ? cardBlur.value + 'px' : '0px';
            const radius = borderRadius ? borderRadius.value + 'px' : '20px';
            const isGlass = glassToggle.checked;

            // Update preview card - matches profile.ejs exactly
            previewCard.style.borderRadius = radius;

            if (isGlass) {
                previewCard.style.background = `rgba(0, 0, 0, ${transparency})`;
                previewCard.style.backdropFilter = `blur(${blur})`;
                previewCard.style.webkitBackdropFilter = `blur(${blur})`;
                previewCard.style.border = '1px solid rgba(255,255,255,0.1)';
                previewCard.style.boxShadow = '0 8px 32px rgba(0,0,0,0.3)';
            } else {
                previewCard.style.background = color;
                previewCard.style.backdropFilter = 'none';
                previewCard.style.webkitBackdropFilter = 'none';
                previewCard.style.border = '1px solid rgba(255,255,255,0.08)';
                previewCard.style.boxShadow = '0 8px 32px rgba(0,0,0,0.3)';
            }

            // Adjust text colors
            const isLight = isLightColor(isGlass ? `rgba(0,0,0,${transparency})` : color);
            const textColor = isLight ? '#1a1a1a' : '#ffffff';
            const textColorDim = isLight ? 'rgba(0,0,0,0.6)' : 'rgba(255,255,255,0.7)';
            const textColorDim2 = isLight ? 'rgba(0,0,0,0.4)' : 'rgba(255,255,255,0.5)';
            const bioBg = isLight ? 'rgba(0,0,0,0.05)' : 'rgba(0,0,0,0.3)';
            const bioColor = isLight ? 'rgba(0,0,0,0.8)' : 'rgba(255,255,255,0.9)';
            const borderColor = isLight ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.06)';
            
            // Update name
            previewName.style.color = textColor;
            previewUsername.style.color = textColorDim;

            // Update bio section
            previewBioSection.style.background = bioBg;
            previewBioSection.style.border = `1px solid ${borderColor}`;
            previewBioText.style.color = bioColor;

            // Update sub tabs
            previewSubTabs.style.background = subTabBg.value || 'rgba(0,0,0,0.2)';
            document.querySelectorAll('.preview-sub-tab').forEach(btn => {
                btn.style.color = subTabLabel.value || 'rgba(255,255,255,0.5)';
                if (btn.classList.contains('active')) {
                    btn.style.color = subTabText.value || 'rgba(255,255,255,0.8)';
                    btn.style.background = 'rgba(255,255,255,0.08)';
                }
            });

            // Update details grid
            const detailItems = document.querySelectorAll('.preview-detail-item');
            detailItems.forEach(item => {
                item.style.background = subTabBg.value || 'rgba(0,0,0,0.2)';
                item.style.borderRadius = subTabRadius.value + 'px' || '8px';
                const label = item.querySelector('.preview-detail-label');
                const value = item.querySelector('.preview-detail-value');
                if (label) label.style.color = subTabLabel.value || 'rgba(255,255,255,0.4)';
                if (value && !value.style.color?.includes('#8B9CF7')) {
                    value.style.color = subTabText.value || 'rgba(255,255,255,0.8)';
                }
            });

            // Update social links
            const socialLinks = document.querySelectorAll('.preview-social-link');
            socialLinks.forEach(link => {
                link.style.background = subTabBg.value || 'rgba(0,0,0,0.2)';
                link.style.borderRadius = subTabRadius.value + 'px' || '8px';
                link.style.color = subTabLabel.value || 'rgba(255,255,255,0.5)';
                // Platform specific hover colors will be applied via CSS
            });

            // Update glass badge
            previewGlassBadge.innerHTML = `
                <i class="bi ${isGlass ? 'bi-window' : 'bi-square'}"></i>
                ${isGlass ? 'Glass' : 'Solid'}
            `;

            // Update status
            glassStatus.textContent = isGlass ? 'ON' : 'OFF';
            glassStatus.className = 'toggle-status ' + (isGlass ? 'on' : 'off');
        }

        // Event Listeners
        cardColor.addEventListener('input', function() {
            cardColorText.value = this.value;
            updatePreview();
        });

        cardColorText.addEventListener('input', function() {
            if (this.value.match(/^#?[0-9A-F]{6}$/i) || this.value.startsWith('rgba')) {
                cardColor.value = this.value;
                updatePreview();
            }
        });

        if (cardTransparency) {
            cardTransparency.addEventListener('input', function() {
                document.getElementById('transparencyValue').textContent = this.value + '%';
                updatePreview();
            });
        }

        if (cardBlur) {
            cardBlur.addEventListener('input', function() {
                document.getElementById('blurValue').textContent = this.value + 'px';
                updatePreview();
            });
        }

        if (borderRadius) {
            borderRadius.addEventListener('input', function() {
                document.getElementById('radiusValue').textContent = this.value + 'px';
                document.querySelectorAll('.radius-preset-btn').forEach(btn => {
                    btn.classList.remove('active');
                    if (parseInt(btn.dataset.radius) === parseInt(this.value)) {
                        btn.classList.add('active');
                    }
                });
                updatePreview();
            });
        }

        // Sub Tab event listeners
        if (subTabRadius) {
            subTabRadius.addEventListener('input', function() {
                subTabRadiusValue.textContent = this.value + 'px';
                updatePreview();
            });
        }

        if (subTabBg) {
            subTabBg.addEventListener('input', function() {
                subTabBgText.value = this.value;
                updatePreview();
            });
            subTabBgText.addEventListener('input', function() {
                if (this.value.match(/^#?[0-9A-F]{6}$/i) || this.value.startsWith('rgba')) {
                    subTabBg.value = this.value;
                    updatePreview();
                }
            });
        }

        if (subTabText) {
            subTabText.addEventListener('input', function() {
                subTabTextValue.value = this.value;
                updatePreview();
            });
            subTabTextValue.addEventListener('input', function() {
                if (this.value.match(/^#?[0-9A-F]{6}$/i) || this.value.startsWith('rgba')) {
                    subTabText.value = this.value;
                    updatePreview();
                }
            });
        }

        if (subTabLabel) {
            subTabLabel.addEventListener('input', function() {
                subTabLabelValue.value = this.value;
                updatePreview();
            });
            subTabLabelValue.addEventListener('input', function() {
                if (this.value.match(/^#?[0-9A-F]{6}$/i) || this.value.startsWith('rgba')) {
                    subTabLabel.value = this.value;
                    updatePreview();
                }
            });
        }

        // Hover color event listeners
        function setupHoverInput(colorInput, textInput) {
            if (!colorInput || !textInput) return;
            colorInput.addEventListener('input', function() {
                textInput.value = this.value;
            });
            textInput.addEventListener('input', function() {
                if (this.value.match(/^#?[0-9A-F]{6}$/i) || this.value.startsWith('rgba')) {
                    colorInput.value = this.value;
                }
            });
        }

        setupHoverInput(detailHoverBg, detailHoverBgText);
        setupHoverInput(socialHoverBg, socialHoverBgText);
        setupHoverInput(twitterHover, twitterHoverText);
        setupHoverInput(githubHover, githubHoverText);
        setupHoverInput(instagramHover, instagramHoverText);
        setupHoverInput(youtubeHover, youtubeHoverText);
        setupHoverInput(linkedinHover, linkedinHoverText);

        // Glass Toggle
        glassToggle.addEventListener('change', function() {
            const status = this.checked ? 'ON' : 'OFF';
            glassStatus.textContent = status;
            glassStatus.className = 'toggle-status ' + (this.checked ? 'on' : 'off');
            
            const glassCategory = document.getElementById('categoryGlass');
            const statusBadge = glassCategory.querySelector('.category-status');
            if (statusBadge) {
                statusBadge.textContent = status;
                statusBadge.className = 'category-status ' + (this.checked ? 'active' : '');
            }
            
            if (this.checked) {
                glassControls.classList.remove('hidden');
            } else {
                glassControls.classList.add('hidden');
            }
            updatePreview();
        });

        // Set Radius
        function setRadius(radius) {
            borderRadius.value = radius;
            document.getElementById('radiusValue').textContent = radius + 'px';
            document.querySelectorAll('.radius-preset-btn').forEach(btn => {
                btn.classList.remove('active');
                if (parseInt(btn.dataset.radius) === radius) {
                    btn.classList.add('active');
                }
            });
            updatePreview();
        }

        // Preset Colors
        function setPreset(color, transparency, blur) {
            cardColor.value = color;
            cardColorText.value = color;
            if (cardTransparency) {
                cardTransparency.value = transparency;
                document.getElementById('transparencyValue').textContent = transparency + '%';
            }
            if (cardBlur) {
                cardBlur.value = blur;
                document.getElementById('blurValue').textContent = blur + 'px';
            }
            updatePreview();
            showToast('Preset applied! Click "Apply Theme" to save.', 'success');
        }

        // Apply Theme
        document.getElementById('applyThemeBtn').addEventListener('click', async function() {
            const btn = this;
            const originalText = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Applying...';

            const themeData = {
                cardColor: cardColor.value,
                glassEffect: glassToggle.checked,
                borderRadius: borderRadius.value + 'px',
                subTabRadius: subTabRadius.value + 'px',
                subTabBg: subTabBg.value,
                subTabText: subTabText.value,
                subTabLabel: subTabLabel.value,
                detailHoverBg: detailHoverBg.value,
                socialHoverBg: socialHoverBg.value,
                twitterHover: twitterHover.value,
                githubHover: githubHover.value,
                instagramHover: instagramHover.value,
                youtubeHover: youtubeHover.value,
                linkedinHover: linkedinHover.value
            };

            if (glassToggle.checked) {
                themeData.cardTransparency = (parseInt(cardTransparency.value) / 100).toString();
                themeData.cardBlur = cardBlur.value + 'px';
            }

            try {
                const response = await fetch('/update-theme', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(themeData)
                });

                const result = await response.json();

                if (result.success) {
                    showToast('✅ Theme applied successfully!', 'success');
                } else {
                    showToast('❌ Error: ' + result.error, 'error');
                }
            } catch (error) {
                showToast('❌ Error applying theme. Please try again.', 'error');
                console.error('Theme error:', error);
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });

        // ===== UTILITY FUNCTIONS =====
        function toggleSidebar() {
            document.getElementById('sidebar').classList.toggle('open');
            document.getElementById('sidebarOverlay').classList.toggle('active');
        }

        function copyUrl() {
            const input = document.getElementById('profileUrl');
            input.select();
            document.execCommand('copy');
            showToast('Profile URL copied to clipboard!', 'success');
        }

        function showToast(message, type = 'success') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            toast.className = `toast ${type === 'error' ? 'toast-error' : ''}`;
            const icon = type === 'error' ? 'bi-x-circle-fill' : 'bi-check-circle-fill';
            toast.innerHTML = `
                <i class="bi ${icon}" style="font-size: 20px;"></i>
                <span>${message}</span>
            `;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.add('toast-hide');
                setTimeout(() => toast.remove(), 350);
            }, 3200);
        }

        // ===== AVATAR UPLOAD =====
        const avatarTrigger = document.getElementById('avatarTrigger');
        const avatarInput = document.getElementById('avatarInput');
        const avatarImg = document.getElementById('avatarImg');
        const avatarPlaceholder = document.getElementById('avatarPlaceholder');

        if (avatarTrigger) {
            avatarTrigger.addEventListener('click', () => {
                avatarInput.click();
            });
        }

        if (avatarInput) {
            avatarInput.addEventListener('change', function(e) {
                const file = this.files[0];
                if (!file) return;

                if (!file.type.startsWith('image/')) {
                    showToast('Please select a valid image.', 'error');
                    this.value = '';
                    return;
                }

                if (file.size > 5 * 1024 * 1024) {
                    showToast('Image size must be less than 5MB.', 'error');
                    this.value = '';
                    return;
                }

                const reader = new FileReader();
                reader.onload = function(ev) {
                    if (avatarImg) {
                        avatarImg.src = ev.target.result;
                        avatarImg.style.display = 'block';
                    }
                    if (avatarPlaceholder) {
                        avatarPlaceholder.style.display = 'none';
                    }
                    // Also update preview avatar
                    const previewAvatar = document.querySelector('.preview-avatar');
                    if (previewAvatar) {
                        previewAvatar.innerHTML = `<img src="${ev.target.result}" alt="Avatar" />`;
                    }
                    showToast('Avatar selected. Click Save to upload.', 'success');
                };
                reader.readAsDataURL(file);
            });
        }

        // ===== FORM SUBMISSION =====
        document.getElementById('profileForm').addEventListener('submit', function(e) {
            const btn = document.getElementById('saveBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-arrow-repeat spin"></i> Saving...';
        });

        // ===== SPIN ANIMATION =====
        const styleSheet = document.createElement('style');
        styleSheet.textContent = `
            @keyframes spin {
                from { transform: rotate(0deg); }
                to { transform: rotate(360deg); }
            }
            .spin {
                animation: spin 1s linear infinite;
                display: inline-block;
            }
        `;
        document.head.appendChild(styleSheet);

        // ===== CHECK SAVED PARAM =====
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('saved') === 'true') {
            showToast('Profile saved successfully!', 'success');
            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // ===== INITIAL PREVIEW UPDATE =====
        setTimeout(updatePreview, 100);
    </script>
</body>
</html>