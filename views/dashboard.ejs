                                        <i class="bi bi-check2-circle"></i> Apply Theme
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Live Preview - Full Profile -->
                        <div class="preview-wrapper">
                            <div class="preview-profile-card" id="previewProfileCard">
                                <% 
                                    let previewAvatarUrl = '';
                                    if (user.avatar) {
                                        previewAvatarUrl = '/' + user.avatar;
                                    } else if (user.avatarDiscord) {
                                        previewAvatarUrl = 'https://cdn.discordapp.com/avatars/' + user.discordId + '/' + user.avatarDiscord + '.png';
                                    }
                                %>
                                <!-- Avatar -->
                                <div class="preview-avatar-wrapper">
                                    <div class="preview-avatar" id="previewAvatar">
                                        <% if (previewAvatarUrl) { %>
                                            <img src="<%= previewAvatarUrl %>" alt="Avatar" />
                                        <% } else { %>
                                            <%= user.globalName ? user.globalName.charAt(0).toUpperCase() : 'U' %>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Name -->
                                <div class="preview-name" id="previewName"><%= user.globalName || user.username %></div>
                                <div class="preview-username" id="previewUsername">@<%= user.username %></div>

