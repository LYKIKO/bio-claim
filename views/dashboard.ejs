                                            </div>

                                            <div class="form-group">
                                                <label><i class="bi bi-share"></i> Platform Hover Colors</label>
                                                <div class="hover-colors-grid">
                                                    <div class="hover-color-item">
                                                        <label>Twitter</label>
                                                        <input type="color" id="twitterHover" value="<%= profile.theme && profile.theme.twitterHover ? profile.theme.twitterHover : 'rgba(29,161,242,0.7)' %>">
                                                        <input type="text" id="twitterHoverText" value="<%= profile.theme && profile.theme.twitterHover ? profile.theme.twitterHover : 'rgba(29,161,242,0.7)' %>">
                                                    </div>
                                                    <div class="hover-color-item">
                                                        <label>GitHub</label>
                                                        <input type="color" id="githubHover" value="<%= profile.theme && profile.theme.githubHover ? profile.theme.githubHover : 'rgba(51,51,51,0.7)' %>">
                                                        <input type="text" id="githubHoverText" value="<%= profile.theme && profile.theme.githubHover ? profile.theme.githubHover : 'rgba(51,51,51,0.7)' %>">
                                                    </div>
                                                    <div class="hover-color-item">
                                                        <label>Instagram</label>
                                                        <input type="color" id="instagramHover" value="<%= profile.theme && profile.theme.instagramHover ? profile.theme.instagramHover : 'rgba(228,64,95,0.7)' %>">
                                                        <input type="text" id="instagramHoverText" value="<%= profile.theme && profile.theme.instagramHover ? profile.theme.instagramHover : 'rgba(228,64,95,0.7)' %>">
                                                    </div>
                                                    <div class="hover-color-item">
                                                        <label>YouTube</label>
                                                        <input type="color" id="youtubeHover" value="<%= profile.theme && profile.theme.youtubeHover ? profile.theme.youtubeHover : 'rgba(255,0,0,0.7)' %>">
                                                        <input type="text" id="youtubeHoverText" value="<%= profile.theme && profile.theme.youtubeHover ? profile.theme.youtubeHover : 'rgba(255,0,0,0.7)' %>">
                                                    </div>
                                                    <div class="hover-color-item">
                                                        <label>LinkedIn</label>
                                                        <input type="color" id="linkedinHover" value="<%= profile.theme && profile.theme.linkedinHover ? profile.theme.linkedinHover : 'rgba(0,119,181,0.7)' %>">
                                                        <input type="text" id="linkedinHoverText" value="<%= profile.theme && profile.theme.linkedinHover ? profile.theme.linkedinHover : 'rgba(0,119,181,0.7)' %>">
