                                                    <input type="color" id="socialHoverBg" value="<%= profile.theme && profile.theme.socialHoverBg ? profile.theme.socialHoverBg : 'rgba(255,255,255,0.08)' %>">
                                                    <input type="text" id="socialHoverBgText" value="<%= profile.theme && profile.theme.socialHoverBg ? profile.theme.socialHoverBg : 'rgba(255,255,255,0.08)' %>" placeholder="Hover background">
