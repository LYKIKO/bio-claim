                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Category: Border Radius -->
                                <div class="category-section" id="categoryRadius">
                                    <div class="category-header" onclick="toggleCategory('categoryRadius')">
                                        <div class="category-header-left">
                                            <div class="category-icon">
                                                <i class="bi bi-border-radius"></i>
                                            </div>
