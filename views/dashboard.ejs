                                                    <span class="color-label">Background</span>
                                                    <input type="color" id="detailHoverBg" value="<%= profile.theme && profile.theme.detailHoverBg ? profile.theme.detailHoverBg : 'rgba(255,255,255,0.08)' %>">
                                                    <input type="text" id="detailHoverBgText" value="<%= profile.theme && profile.theme.detailHoverBg ? profile.theme.detailHoverBg : 'rgba(255,255,255,0.08)' %>" placeholder="Hover background">
