                                <div class="preview-badge-row">
                                    <span class="preview-badge-verified"><i class="bi bi-check-circle-fill"></i> Verified</span>
                                    <span class="preview-glass-badge" id="previewGlassBadge">
                                        <i class="bi <%= profile.theme && profile.theme.glassEffect ? 'bi-window' : 'bi-square' %>"></i>
                                        <%= profile.theme && profile.theme.glassEffect ? 'Glass' : 'Solid' %>
                                    </span>
                                </div>

