                                                <i class="bi bi-twitter"></i> Twitter
                                            </a>
                                        <% } %>
                                        <% if (profile.github) { %>
                                            <a href="#" class="preview-social-link github" id="previewGithub">
                                                <i class="bi bi-github"></i> GitHub
                                            </a>
                                        <% } %>
                                        <% if (profile.instagram) { %>
