                                                <div class="form-group">
                                                    <label><i class="bi bi-eyedropper"></i> Transparency <span id="transparencyValue"><%= profile.theme && profile.theme.cardTransparency ? (parseFloat(profile.theme.cardTransparency) * 100).toFixed(0) : '95' %>%</span></label>
                                                    <input type="range" id="cardTransparency" min="0" max="100" step="1" value="<%= profile.theme && profile.theme.cardTransparency ? parseFloat(profile.theme.cardTransparency) * 100 : '95' %>">
                                                </div>

                                                <div class="form-group">
                                                    <label><i class="bi bi-eye"></i> Blur <span id="blurValue"><%= profile.theme && profile.theme.cardBlur ? profile.theme.cardBlur : '10px' %></span></label>
                                                    <input type="range" id="cardBlur" min="0" max="30" step="1" value="<%= profile.theme && profile.theme.cardBlur ? parseInt(profile.theme.cardBlur) : '10' %>">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Category: Colors -->
                                <div class="category-section" id="categoryColors">
                                    <div class="category-header" onclick="toggleCategory('categoryColors')">
                                        <div class="category-header-left">
                                            <div class="category-icon">
                                                <i class="bi bi-fill"></i>
                                            </div>
                                            <div class="category-header-info">
                                                <div class="category-header-title">
                                                    Colors
                                                    <span class="badge-count">6 presets</span>
                                                </div>
                                                <div class="category-header-desc">Background color and quick presets</div>
                                            </div>
                                        </div>
                                        <div class="category-header-right">
                                            <span class="category-chevron"><i class="bi bi-chevron-down"></i></span>
                                        </div>
                                    </div>
                                    <div class="category-content">
                                        <div class="category-content-inner">
                                            <div class="form-group">
                                                <label><i class="bi bi-palette"></i> Card Background</label>
                                                <div class="color-picker-group">
