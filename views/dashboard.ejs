                                <div class="preview-bio-section" id="previewBioSection">
                                    <h3><i class="bi bi-chat"></i> About</h3>
                                    <p id="previewBioText"><%= profile.bio || 'This user hasn\'t added a bio yet.' %></p>
                                </div>

                                <!-- Sub Tabs -->
                                <div class="preview-sub-tabs" id="previewSubTabs">
                                    <button class="preview-sub-tab active" data-tab="details">
                                        <i class="bi bi-grid"></i> Details
                                    </button>
                                    <button class="preview-sub-tab" data-tab="social">
                                        <i class="bi bi-share"></i> Social
                                    </button>
                                </div>

                                <!-- Details Panel -->
                                <div id="previewDetailsPanel">
                                    <div class="preview-details-grid" id="previewDetailsGrid">
                                        <div class="preview-detail-item" id="previewDetail1">
                                            <div class="preview-detail-label"><i class="bi bi-calendar3"></i> Joined</div>
                                            <div class="preview-detail-value"><%= profile ? new Date(profile.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : 'N/A' %></div>
                                        </div>
                                        <div class="preview-detail-item" id="previewDetail2">
                                            <div class="preview-detail-label"><i class="bi bi-link-45deg"></i> Profile URL</div>
                                            <div class="preview-detail-value" style="color: #8B9CF7;">/<%= user.customUrl %></div>
                                        </div>
                                        <div class="preview-detail-item" id="previewDetail3">
                                            <div class="preview-detail-label"><i class="bi bi-geo-alt"></i> Location</div>
