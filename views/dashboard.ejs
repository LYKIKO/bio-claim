                                                </div>
                                                <div class="category-header-desc">Frosted glass appearance with blur</div>
                                            </div>
                                        </div>
                                        <div class="category-header-right">
                                            <span class="category-status <%= profile.theme && profile.theme.glassEffect ? 'active' : '' %>">
                                                <%= profile.theme && profile.theme.glassEffect ? 'ON' : 'OFF' %>
                                            </span>
                                            <span class="category-chevron"><i class="bi bi-chevron-down"></i></span>
                                        </div>
                                    </div>
                                    <div class="category-content">
