                                            <div class="category-icon">
                                                <i class="bi bi-layout-three-columns"></i>
                                            </div>
                                            <div class="category-header-info">
                                                <div class="category-header-title">
                                                    Sub Tab Styles
                                                    <span class="badge-count">5 options</span>
                                                </div>
                                                <div class="category-header-desc">Details grid & social links appearance</div>
                                            </div>
                                        </div>
                                        <div class="category-header-right">
                                            <span class="category-chevron"><i class="bi bi-chevron-down"></i></span>
                                        </div>
                                    </div>
                                    <div class="category-content">
                                        <div class="category-content-inner">
                                            <div class="form-group">
                                                <label><i class="bi bi-border-radius"></i> Sub Tab Border Radius</label>
                                                <div class="color-picker-group">
                                                    <span class="color-label">Radius</span>
                                                    <input type="range" id="subTabRadius" min="0" max="30" step="1" value="<%= profile.theme && profile.theme.subTabRadius ? profile.theme.subTabRadius : '12' %>" style="flex: 1;">
                                                    <span style="font-size: 13px; font-weight: 600; color: var(--gray); min-width: 40px;" id="subTabRadiusValue"><%= profile.theme && profile.theme.subTabRadius ? profile.theme.subTabRadius : '12' %>px</span>
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label><i class="bi bi-fill"></i> Sub Tab Background</label>
                                                <div class="color-picker-group">
                                                    <span class="color-label">Color</span>
                                                    <input type="color" id="subTabBg" value="<%= profile.theme && profile.theme.subTabBg ? profile.theme.subTabBg : 'rgba(0,0,0,0.2)' %>">
                                                    <input type="text" id="subTabBgText" value="<%= profile.theme && profile.theme.subTabBg ? profile.theme.subTabBg : 'rgba(0,0,0,0.2)' %>" placeholder="Background color">
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label><i class="bi bi-fonts"></i> Sub Tab Text Color</label>
                                                <div class="color-picker-group">
                                                    <span class="color-label">Color</span>
                                                    <input type="color" id="subTabText" value="<%= profile.theme && profile.theme.subTabText ? profile.theme.subTabText : 'rgba(255,255,255,0.8)' %>">
                                                    <input type="text" id="subTabTextValue" value="<%= profile.theme && profile.theme.subTabText ? profile.theme.subTabText : 'rgba(255,255,255,0.8)' %>" placeholder="Text color">
                                                </div>
                                            </div>

                                            <div class="form-group">
                                                <label><i class="bi bi-fonts"></i> Sub Tab Label Color</label>
                                                <div class="color-picker-group">
                                                    <span class="color-label">Color</span>
                                                    <input type="color" id="subTabLabel" value="<%= profile.theme && profile.theme.subTabLabel ? profile.theme.subTabLabel : 'rgba(255,255,255,0.5)' %>">
                                                    <input type="text" id="subTabLabelValue" value="<%= profile.theme && profile.theme.subTabLabel ? profile.theme.subTabLabel : 'rgba(255,255,255,0.5)' %>" placeholder="Label color">
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Category: Hover Colors -->
                                <div class="category-section" id="categoryHover">
                                    <div class="category-header" onclick="toggleCategory('categoryHover')">
                                        <div class="category-header-left">
                                            <div class="category-icon">
                                                <i class="bi bi-hand-index"></i>
                                            </div>
                                            <div class="category-header-info">
                                                <div class="category-header-title">
                                                    Hover Colors
                                                    <span class="badge-count">7 options</span>
                                                </div>
                                                <div class="category-header-desc">Custom hover effects for details & social links</div>
                                            </div>
                                        </div>
                                        <div class="category-header-right">
                                            <span class="category-chevron"><i class="bi bi-chevron-down"></i></span>
