<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title><%= profile.globalName || profile.username %> · ProfileLink</title>
    <link rel="preconnect" href="https://rsms.me/" />
    <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        * { margin:0; padding:0; box-sizing:border-box; }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
            margin: 0;
            position: relative;
            
           
            background-size: 400% 400%;
            animation: gradientBG 15s ease infinite;
        }

        @keyframes gradientBG {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        /* Animated particles/overlay for extra visual interest */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: 
                radial-gradient(circle at 20% 50%, rgba(88, 101, 242, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 50%, rgba(118, 75, 162, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 50% 80%, rgba(59, 165, 93, 0.1) 0%, transparent 50%);
            z-index: 0;
            pointer-events: none;
        }

        /* Floating shapes for background depth */
        body::after {
            content: '';
            position: fixed;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: 
                radial-gradient(circle at 70% 30%, rgba(255,255,255,0.03) 0%, transparent 30%),
                radial-gradient(circle at 30% 70%, rgba(255,255,255,0.02) 0%, transparent 30%);
            z-index: 0;
            pointer-events: none;
            animation: floatBG 20s ease-in-out infinite alternate;
        }

        @keyframes floatBG {
            0% { transform: translate(0, 0) rotate(0deg); }
            100% { transform: translate(-5%, -5%) rotate(5deg); }
        }

        /* Profile Card - Theme Applied Here */
        .profile-card {
            transform-style: preserve-3d;
            perspective: 1200px;
            will-change: transform;
            max-width: 520px;
            width: 100%;
            padding: 48px 40px;
            border-radius: 24px;
            text-align: center;
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            z-index: 1;
            
            <% 
                // Get theme properties with defaults
                const cardColor = profile.theme && profile.theme.cardColor ? profile.theme.cardColor : 'rgba(0, 0, 0, 0.3)';
                const transparency = profile.theme && profile.theme.cardTransparency ? parseFloat(profile.theme.cardTransparency) : 0.3;
                const blur = profile.theme && profile.theme.cardBlur ? profile.theme.cardBlur : '20px';
                const glassEffect = profile.theme && profile.theme.glassEffect !== undefined ? profile.theme.glassEffect : true;
                const borderRadius = profile.theme && profile.theme.borderRadius ? profile.theme.borderRadius : '24px';
                
                // Sub Tab theme properties
                const subTabRadius = profile.theme && profile.theme.subTabRadius ? profile.theme.subTabRadius : '12px';
                const subTabBg = profile.theme && profile.theme.subTabBg ? profile.theme.subTabBg : 'rgba(0,0,0,0.2)';
                const subTabText = profile.theme && profile.theme.subTabText ? profile.theme.subTabText : 'rgba(255,255,255,0.8)';
                const subTabLabel = profile.theme && profile.theme.subTabLabel ? profile.theme.subTabLabel : 'rgba(255,255,255,0.5)';
                
                // Hover colors
                const detailHoverBg = profile.theme && profile.theme.detailHoverBg ? profile.theme.detailHoverBg : 'rgba(255,255,255,0.08)';
                const socialHoverBg = profile.theme && profile.theme.socialHoverBg ? profile.theme.socialHoverBg : 'rgba(255,255,255,0.08)';
                
                // Social platform hover colors
                const twitterHover = profile.theme && profile.theme.twitterHover ? profile.theme.twitterHover : 'rgba(29,161,242,0.7)';
                const githubHover = profile.theme && profile.theme.githubHover ? profile.theme.githubHover : 'rgba(51,51,51,0.7)';
                const instagramHover = profile.theme && profile.theme.instagramHover ? profile.theme.instagramHover : 'rgba(228,64,95,0.7)';
                const youtubeHover = profile.theme && profile.theme.youtubeHover ? profile.theme.youtubeHover : 'rgba(255,0,0,0.7)';
                const linkedinHover = profile.theme && profile.theme.linkedinHover ? profile.theme.linkedinHover : 'rgba(0,119,181,0.7)';
                const locationHover = profile.theme && profile.theme.locationHover ? profile.theme.locationHover : 'rgba(255,255,255,0.08)';
                
                // Helper function to check if color is light
                function isLightColor(hex) {
                    if (!hex) return false;
                    if (hex === '#ffffff' || hex === '#fff') return true;
                    if (hex.startsWith('rgba')) {
                        const matches = hex.match(/[\d.]+/g);
                        if (matches) {
                            const r = parseFloat(matches[0]);
                            const g = parseFloat(matches[1]);
                            const b = parseFloat(matches[2]);
                            const brightness = (r * 299 + g * 587 + b * 114) / 1000;
                            return brightness > 155;
                        }
                        return false;
                    }
                    const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
                    if (!result) return false;
                    const r = parseInt(result[1], 16);
                    const g = parseInt(result[2], 16);
                    const b = parseInt(result[3], 16);
                    const brightness = (r * 299 + g * 587 + b * 114) / 1000;
                    return brightness > 155;
                }
                
                // Determine text color based on background
                const isLight = isLightColor(glassEffect ? `rgba(0,0,0,${transparency})` : cardColor);
                const textColor = isLight ? '#1a1a1a' : '#ffffff';
                const textColorDim = isLight ? 'rgba(0,0,0,0.6)' : 'rgba(255,255,255,0.7)';
                const textColorDim2 = isLight ? 'rgba(0,0,0,0.4)' : 'rgba(255,255,255,0.5)';
                const bioBg = isLight ? 'rgba(0,0,0,0.05)' : 'rgba(0,0,0,0.3)';
                const bioColor = isLight ? 'rgba(0,0,0,0.8)' : 'rgba(255,255,255,0.9)';
                const borderColor = isLight ? 'rgba(0,0,0,0.06)' : 'rgba(255,255,255,0.06)';
                const borderColor2 = isLight ? 'rgba(0,0,0,0.12)' : 'rgba(255,255,255,0.12)';
            %>
            
            /* Theme properties */
            background: <%= glassEffect ? `rgba(0, 0, 0, ${transparency})` : cardColor %>;
            backdrop-filter: <%= glassEffect ? `blur(${blur})` : 'none' %>;
            -webkit-backdrop-filter: <%= glassEffect ? `blur(${blur})` : 'none' %>;
            border-radius: <%= borderRadius %>;
            
            /* Card border */
            border: 1px solid rgba(255, 255, 255, 0.08);
            box-shadow: 
                0 8px 32px rgba(0, 0, 0, 0.4),
                inset 0 1px 0 rgba(255, 255, 255, 0.05),
                0 0 40px rgba(88, 101, 242, 0.05);
        }

        /* Inner glow effect for glass */
        .profile-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.05) 0%, transparent 50%);
            z-index: 0;
            pointer-events: none;
            border-radius: <%= borderRadius %>;
        }

        /* Shine effect on hover */
        .profile-card::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, 
                transparent, 
                rgba(255,255,255,0.03), 
                transparent
            );
            transform: skewX(-25deg);
            transition: left 0.8s ease;
            z-index: 0;
            pointer-events: none;
            border-radius: <%= borderRadius %>;
        }

        .profile-card:hover::after {
            left: 100%;
        }

        .profile-card:hover { 
            transform: translateY(-4px) scale(1.01);
            box-shadow: 
                0 12px 48px rgba(0, 0, 0, 0.5),
                inset 0 1px 0 rgba(255, 255, 255, 0.08),
                0 0 60px rgba(88, 101, 242, 0.1);
        }

        /* Content wrapper - ensures text stays above glass */
        .profile-card > * {
            position: relative;
            z-index: 2;
        }

        /* avatar */
        .avatar-wrapper {
            position: relative;
            width: 128px;
            height: 128px;
            margin: 0 auto 20px;
            z-index: 2;
        }
        .avatar {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            background: linear-gradient(135deg, #5865F2, #4752C4);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 52px;
            font-weight: 700;
            color: white;
            overflow: hidden;
            border: 3px solid rgba(255,255,255,0.15);
            transition: border-color 0.3s, transform 0.3s, box-shadow 0.3s;
            position: relative;
            z-index: 2;
            box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        }
        .avatar:hover { 
            border-color: rgba(255,255,255,0.3);
            transform: scale(1.05);
            box-shadow: 0 12px 40px rgba(88,101,242,0.3);
        }
        .avatar img { width:100%; height:100%; object-fit:cover; }

        /* Text styles - dynamically colored based on theme */
        .name { 
            font-size: 32px; 
            font-weight: 700; 
            margin-bottom: 4px; 
            letter-spacing: -0.5px;
            color: <%= textColor %>;
            text-shadow: 0 2px 20px rgba(0,0,0,0.2);
            position: relative;
            z-index: 2;
        }
        .username { 
            font-size: 16px; 
            color: <%= textColorDim %>;
            margin-bottom: 8px;
            text-shadow: 0 2px 12px rgba(0,0,0,0.2);
            position: relative;
            z-index: 2;
        }


        /* Glass effect indicator badge */
        .glass-badge {
            display: inline-block;
            padding: 2px 12px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(4px);
            color: rgba(255,255,255,0.7);
            border: 1px solid rgba(255,255,255,0.08);
            text-shadow: 0 1px 4px rgba(0,0,0,0.2);
        }

        /* Bio Section */
        .bio-section {
            background: <%= bioBg %>;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            padding: 20px 24px;
            border-radius: 16px;
            border: 1px solid <%= borderColor %>;
            text-align: left;
            margin-bottom: 16px;
            position: relative;
            z-index: 2;
        }
        .bio-section h3 {
            font-size: 11px;
            color: <%= textColorDim2 %>;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            gap: 6px;
        }
        .bio-section p {
            font-size: 15px;
            color: <%= bioColor %>;
            line-height: 1.7;
            word-wrap: break-word;
            text-shadow: 0 1px 8px rgba(0,0,0,0.1);
        }
        .bio-empty { 
            color: <%= textColorDim2 %>;
            font-style: italic; 
        }

        /* SUB TABS - Using Sub Tab Theme Properties */
        .sub-tabs {
            display: flex;
            gap: 8px;
            background: <%= subTabBg %>;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border-radius: 16px;
            padding: 4px;
            margin-bottom: 16px;
            border: 1px solid rgba(255,255,255,0.06);
            position: relative;
            z-index: 2;
        }
        .sub-tab-btn {
            flex: 1;
            background: transparent;
            border: none;
            padding: 10px 0;
            border-radius: <%= subTabRadius %>;
            font-size: 14px;
            font-weight: 600;
            color: <%= subTabLabel %>;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .sub-tab-btn i { font-size: 16px; }
        .sub-tab-btn.active {
            background: rgba(255,255,255,0.1);
            color: <%= subTabText %>;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        }
        .sub-tab-btn:hover:not(.active) { 
            color: <%= subTabText %>;
        }

        /* sub tab panels */
        .sub-tab-panel {
            display: none;
            animation: fadeIn 0.25s ease;
            position: relative;
            z-index: 2;
        }
        .sub-tab-panel.active { display: block; }

        @keyframes fadeIn {
            0% { opacity: 0.4; transform: translateY(6px); }
            100% { opacity: 1; transform: translateY(0); }
        }

        /* ===== DETAILS GRID - With Custom Hover ===== */
        .details-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }
        .detail-item {
            background: <%= subTabBg %>;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            padding: 14px 16px;
            border-radius: <%= subTabRadius %>;
            border: 1px solid rgba(255,255,255,0.06);
            text-align: left;
            transition: all 0.3s;
            cursor: pointer;
        }
        .detail-item:hover { 
            background: <%= detailHoverBg %> !important;
            border-color: rgba(255,255,255,0.12);
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.2);
        }
        .detail-label {
            font-size: 10px;
            color: <%= subTabLabel %>;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            margin-bottom: 4px;
            display: flex;
            align-items: center;
            gap: 4px;
        }
        .detail-value {
            font-size: 14px;
            font-weight: 500;
            color: <%= subTabText %>;
            word-break: break-all;
            text-shadow: 0 1px 4px rgba(0,0,0,0.1);
        }
        .detail-value a { 
            color: #8B9CF7; 
            text-decoration: none; 
            transition: color 0.2s; 
        }
        .detail-value a:hover { 
            color: #A8B8FF; 
            text-decoration: underline; 
        }

        /* ===== SOCIAL LINKS - With Platform Specific Hovers ===== */
        .social-panel {
            display: flex;
            flex-direction: column;
            gap: 16px;
            position: relative;
            z-index: 2;
        }
        .social-links {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 10px;
        }
        .social-link {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 18px;
            background: <%= subTabBg %>;
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: <%= subTabRadius %>;
            color: <%= subTabLabel %>;
            text-decoration: none;
            font-size: 13px;
            font-weight: 500;
            transition: all 0.3s;
            text-shadow: 0 1px 4px rgba(0,0,0,0.1);
            cursor: pointer;
        }
        .social-link i { font-size: 16px; }
        
        /* Default hover for all social links */
        .social-link:hover {
            background: <%= socialHoverBg %>;
            color: <%= subTabText %>;
            border-color: rgba(255,255,255,0.15);
            transform: translateY(-2px);
            box-shadow: 0 4px 16px rgba(0,0,0,0.3);
        }

        /* Platform specific hover colors */
        .social-link.twitter:hover { 
            background: <%= twitterHover %>; 
            border-color: #1DA1F2; 
            color: white; 
        }
        .social-link.github:hover { 
            background: <%= githubHover %>; 
            border-color: #666; 
            color: white; 
        }
        .social-link.instagram:hover { 
            background: <%= instagramHover %>; 
            border-color: #E4405F; 
            color: white; 
        }
        .social-link.youtube:hover { 
            background: <%= youtubeHover %>; 
            border-color: #FF0000; 
            color: white; 
        }
        .social-link.linkedin:hover { 
            background: <%= linkedinHover %>; 
            border-color: #0077B5; 
            color: white; 
        }
        .social-link.location:hover { 
            background: <%= locationHover %>; 
            border-color: rgba(255,255,255,0.15); 
            color: <%= subTabText %>; 
        }

        .social-empty {
            color: <%= subTabLabel %>;
            font-size: 13px;
            padding: 10px;
            background: <%= subTabBg %>;
            backdrop-filter: blur(8px);
            border-radius: <%= subTabRadius %>;
            border: 1px dashed rgba(255,255,255,0.08);
            width: 100%;
            text-align: center;
        }

        /* footer */
        .profile-footer {
            margin-top: 28px;
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,0.06);
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            position: relative;
            z-index: 2;
        }
        .join-date {
            font-size: 12px;
            color: <%= textColorDim2 %>;
            display: flex;
            align-items: center;
            gap: 6px;
            text-shadow: 0 1px 4px rgba(0,0,0,0.1);
        }
        .action-buttons {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            justify-content: center;
            width: 100%;
        }
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 24px;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s;
            border: none;
            cursor: pointer;
        }
        .btn-primary {
            background: rgba(88,101,242,0.8);
            backdrop-filter: blur(4px);
            color: white;
            box-shadow: 0 4px 16px rgba(88,101,242,0.2);
            border: 1px solid rgba(255,255,255,0.1);
        }
        .btn-primary:hover {
            background: rgba(88,101,242,1);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(88,101,242,0.3);
        }
        .btn-secondary {
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(4px);
            color: <%= textColorDim %>;
            border: 1px solid rgba(255,255,255,0.06);
        }
        .btn-secondary:hover {
            background: rgba(255,255,255,0.1);
            color: <%= textColor %>;
            border-color: rgba(255,255,255,0.12);
            transform: translateY(-2px);
        }

    

        /* responsive */
        @media (max-width: 600px) {
            .profile-card { padding: 32px 20px; }
            .avatar-wrapper { width: 100px; height: 100px; }
            .avatar { font-size: 40px; }
            .name { font-size: 26px; }
            .details-grid { grid-template-columns: 1fr; }
            .social-links { flex-direction: column; align-items: stretch; }
            .social-link { justify-content: center; }
            .action-buttons { flex-direction: column; width:100%; }
            .btn { justify-content: center; width:100%; }
        
        }
    </style>
</head>
<body>
    <div class="profile-card">

        <!-- Avatar -->
        <div class="avatar-wrapper">
            <div class="avatar">
                <% 
                    let avatarUrl = '';
                    if (profile.avatar) {
                        avatarUrl = '/' + profile.avatar;
                    } else if (profile.avatarDiscord) {
                        avatarUrl = 'https://cdn.discordapp.com/avatars/' + profile.discordId + '/' + profile.avatarDiscord + '.png';
                    }
                %>
                <% if (avatarUrl) { %>
                    <img src="<%= avatarUrl %>" alt="<%= profile.globalName || profile.username %>" />
                <% } else { %>
                    <%= profile.globalName ? profile.globalName.charAt(0).toUpperCase() : profile.username.charAt(0).toUpperCase() %>
                <% } %>
            </div>
        </div>

        <!-- Name & Badge -->
        <div class="name"><%= profile.globalName || profile.username %></div>
        <div class="username">@<%= profile.username %></div>
        

        <!-- Bio Section -->
        <div class="bio-section">
            <h3><i class="bi bi-chat"></i> About</h3>
            <p>
                <% if (profile.bio && profile.bio.trim() !== '') { %>
                    <%= profile.bio %>
                <% } else { %>
                    <span class="bio-empty">This user hasn't added a bio yet.</span>
                <% } %>
            </p>
        </div>

        <!-- SUB TABS -->
        <div class="sub-tabs" role="tablist">
            <button class="sub-tab-btn active" data-tab="details" role="tab" aria-selected="true">
                <i class="bi bi-grid"></i> Details
            </button>
            <button class="sub-tab-btn" data-tab="social" role="tab" aria-selected="false">
                <i class="bi bi-share"></i> Social
            </button>
        </div>

        <!-- SUB PANEL: DETAILS -->
        <div id="subpanel-details" class="sub-tab-panel active" role="tabpanel">
            <div class="details-grid">
                <div class="detail-item">
                    <div class="detail-label"><i class="bi bi-calendar3"></i> Joined</div>
                    <div class="detail-value">
                        <%= new Date(profile.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) %>
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label"><i class="bi bi-link-45deg"></i> Profile URL</div>
                    <div class="detail-value" style="color: #8B9CF7; font-size: 13px;">
                        /<%= profile.customUrl %>
                    </div>
                </div>
                <div class="detail-item">
                    <div class="detail-label"><i class="bi bi-geo-alt"></i> Location</div>
                    <div class="detail-value"><%= profile.location || 'Not set' %></div>
                </div>
                <div class="detail-item">
                    <div class="detail-label"><i class="bi bi-hash"></i> Discord ID</div>
                    <div class="detail-value" style="font-size: 12px; color: <%= subTabLabel %>;"><%= profile.discordId %></div>
                </div>
            </div>
        </div>

        <!-- SUB PANEL: SOCIAL -->
        <div id="subpanel-social" class="sub-tab-panel" role="tabpanel">
            <div class="social-panel">
                <div class="social-links">
                    <% if (profile.twitter) { %>
                        <a href="<%= profile.twitter %>" target="_blank" class="social-link twitter">
                            <i class="bi bi-twitter"></i> Twitter
                        </a>
                    <% } %>
                    <% if (profile.github) { %>
                        <a href="<%= profile.github %>" target="_blank" class="social-link github">
                            <i class="bi bi-github"></i> GitHub
                        </a>
                    <% } %>
                    <% if (profile.instagram) { %>
                        <a href="<%= profile.instagram %>" target="_blank" class="social-link instagram">
                            <i class="bi bi-instagram"></i> Instagram
                        </a>
                    <% } %>
                    <% if (profile.youtube) { %>
                        <a href="<%= profile.youtube %>" target="_blank" class="social-link youtube">
                            <i class="bi bi-youtube"></i> YouTube
                        </a>
                    <% } %>
                    <% if (profile.linkedin) { %>
                        <a href="<%= profile.linkedin %>" target="_blank" class="social-link linkedin">
                            <i class="bi bi-linkedin"></i> LinkedIn
                        </a>
                    <% } %>
                    <% if (!profile.twitter && !profile.github && !profile.instagram && !profile.youtube && !profile.linkedin) { %>
                        <span class="social-empty">
                            <i class="bi bi-link-45deg"></i> No social links added
                        </span>
                    <% } %>
                </div>
            </div>
        </div>

        

        
    </div>

    <!-- Sub Tab switcher script -->
    <script>
        (function() {
            const subTabs = document.querySelectorAll('.sub-tab-btn');
            const subPanels = {
                details: document.getElementById('subpanel-details'),
                social: document.getElementById('subpanel-social')
            };

            function activateSubTab(tabId) {
                subTabs.forEach(btn => {
                    const isActive = btn.dataset.tab === tabId;
                    btn.classList.toggle('active', isActive);
                    btn.setAttribute('aria-selected', isActive);
                });

                Object.keys(subPanels).forEach(key => {
                    const panel = subPanels[key];
                    if (key === tabId) {
                        panel.classList.add('active');
                        panel.style.display = 'block';
                    } else {
                        panel.classList.remove('active');
                        panel.style.display = 'none';
                    }
                });
            }

            subTabs.forEach(btn => {
                btn.addEventListener('click', function(e) {
                    const tabId = this.dataset.tab;
                    if (tabId) activateSubTab(tabId);
                });
            });

            if (!document.querySelector('.sub-tab-btn.active')) {
                const defaultTab = document.querySelector('.sub-tab-btn[data-tab="details"]');
                if (defaultTab) defaultTab.classList.add('active');
            }
            const activeBtn = document.querySelector('.sub-tab-btn.active');
            if (activeBtn) {
                const tabId = activeBtn.dataset.tab;
                Object.keys(subPanels).forEach(key => {
                    const panel = subPanels[key];
                    if (key === tabId) {
                        panel.classList.add('active');
                        panel.style.display = 'block';
                    } else {
                        panel.classList.remove('active');
                        panel.style.display = 'none';
                    }
                });
            }
        })();
    </script>
    <script>
        (() => {
            const card = document.querySelector(".profile-card");
            if (!card) return;

            const MAX_ROTATE = 10;
            const MAX_TRANSLATE = 12;
            const PERSPECTIVE = 1200;
            const SMOOTHING = 0.08;

            let currentX = 0;
            let currentY = 0;
            let targetX = 0;
            let targetY = 0;
            let isHovering = false;
            let animationFrame = null;

            card.style.transformStyle = "preserve-3d";
            card.style.willChange = "transform";

            // Get theme and check if 3D effect is enabled
            let is3DEnabled = true;
            try {
                // Get profile theme from the rendered data
                const profileData = <%- JSON.stringify(profile) %>;
                if (profileData && profileData.theme) {
                    is3DEnabled = profileData.theme['3dparallaxfollow'] !== undefined ? 
                                profileData.theme['3dparallaxfollow'] : true;
                }
            } catch (e) {
                console.error('Error parsing theme:', e);
                is3DEnabled = true; // Default to enabled
            }

            function updateCard() {
                if (!isHovering) {
                    currentX += (0 - currentX) * SMOOTHING;
                    currentY += (0 - currentY) * SMOOTHING;
                    
                    if (Math.abs(currentX) < 0.01 && Math.abs(currentY) < 0.01) {
                        currentX = 0;
                        currentY = 0;
                        card.style.transition = "transform 0.6s cubic-bezier(.23,1,.32,1)";
                        card.style.transform = `
                            perspective(${PERSPECTIVE}px)
                            rotateX(0deg)
                            rotateY(0deg)
                            translateX(0)
                            translateY(0)
                            scale(1)
                        `;
                        return;
                    }
                } else {
                    currentX += (targetX - currentX) * SMOOTHING;
                    currentY += (targetY - currentY) * SMOOTHING;
                }

                card.style.transition = "none";
                card.style.transform = `
                    perspective(${PERSPECTIVE}px)
                    rotateX(${currentY}deg)
                    rotateY(${currentX}deg)
                    translateX(${currentX * 1.2}px)
                    translateY(${currentY * 1.2}px)
                    scale(${isHovering ? 1.02 : 1})
                `;

                if (isHovering || Math.abs(currentX) > 0.01 || Math.abs(currentY) > 0.01) {
                    animationFrame = requestAnimationFrame(updateCard);
                } else {
                    animationFrame = null;
                }
            }

            function handleMouseMove(e) {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                const centerX = rect.width / 2;
                const centerY = rect.height / 2;

                targetX = ((x - centerX) / centerX) * MAX_ROTATE;
                targetY = -((y - centerY) / centerY) * MAX_ROTATE;

                if (!animationFrame && isHovering) {
                    animationFrame = requestAnimationFrame(updateCard);
                }
            }

            function handleMouseEnter() {
                isHovering = true;
                card.style.transition = "transform 0.08s ease-out";
                if (!animationFrame) {
                    animationFrame = requestAnimationFrame(updateCard);
                }
            }

            function handleMouseLeave() {
                isHovering = false;
                targetX = 0;
                targetY = 0;
                if (!animationFrame) {
                    animationFrame = requestAnimationFrame(updateCard);
                }
            }

            // Only enable 3D effect if theme setting is true
            if (is3DEnabled) {
                card.addEventListener("mousemove", handleMouseMove);
                card.addEventListener("mouseenter", handleMouseEnter);
                card.addEventListener("mouseleave", handleMouseLeave);
                console.log("3D Parallax Follow: ENABLED");
            } else {
                // Disable 3D effect - keep card flat
                card.style.transform = "none";
                card.style.transformStyle = "flat";
                card.style.willChange = "auto";
                console.log("3D Parallax Follow: DISABLED");
            }

            // Cleanup on page unload
            window.addEventListener('unload', () => {
                if (animationFrame) {
                    cancelAnimationFrame(animationFrame);
                }
                card.removeEventListener("mousemove", handleMouseMove);
                card.removeEventListener("mouseenter", handleMouseEnter);
                card.removeEventListener("mouseleave", handleMouseLeave);
            });
        })();
    </script>
</body>
</html>